desc:HyperAudio IEM KZ EDX Pro · GHD
//tags: iem limiter true-peak lookahead
// Note: Default -1.5 dBFS ceiling trades 1.5 dB peak headroom to eliminate inter-sample clipping on downstream DACs.
// Continuous 8-tap 4x Sinc true-peak interpolation (BS.1770-4), 1.5ms bounded lookahead.

preGain10:0<-120,60,1>Pre Gain tenths dB
ceilDb10:-15<-600,-3,1>Limiter Ceiling tenths dBFS
relMs:80<10,500,1>Limiter Release ms
tpDetect:1<0,1,1{Off,On}>True Peak Detect

@init
!init_done ? (
  tpDetect = 1;
  preGain10 = 0;
  ceilDb10 = -15;
  relMs = 80;
  init_done = 1;
);

fs = srate > 0 ? srate : 48000;
pre_k = 1.0 - exp(-1.0 / (0.01 * fs));
preLin = 1.0;
preTgt = 1.0;
ceilLin = 0.841395;
rel_k = 0.001;
prev_pre = -99999;
prev_ceil = -99999;
prev_rel = -99999;

// 2.0 Hz ultra-clean Bessel DC blocker
dcR = exp(-2.0 * $PI * 2.0 / fs);
dxL = 0.0; dyL = 0.0;
dxR = 0.0; dyR = 0.0;

// 1.5 ms linear lookahead buffer (N = 73 samples @ 48kHz)
D = floor(0.0015 * fs + 0.5);
D = max(2, min(500, D));
N = D + 1;

dlyL = 0;
dlyR = N;
reqB = 2 * N;
eB   = 3 * N;

i = 0;
loop(N,
  dlyL[i] = 0.0;
  dlyR[i] = 0.0;
  reqB[i] = 1.0;
  i += 1;
);

i = 0;
loop(D,
  eB[i] = 1.0;
  i += 1;
);

w = 0;
ew = 0;
active = 0;
eprev = 1.0;
esum = D;
chk = 0;

fadeLen = max(1, floor(0.05 * fs));
fadeN = 0;

// Continuous 8-tap 4x Sinc ISP registers
ia0 = 0.0; ib0 = 0.0;
ia1 = 0.0; ib1 = 0.0;
ia2 = 0.0; ib2 = 0.0;
ia3 = 0.0; ib3 = 0.0;
ia4 = 0.0; ib4 = 0.0;
ia5 = 0.0; ib5 = 0.0;
ia6 = 0.0; ib6 = 0.0;
ia7 = 0.0; ib7 = 0.0;

@sample
(preGain10 != prev_pre || ceilDb10 != prev_ceil || relMs != prev_rel) ? (
  prev_pre = preGain10;
  prev_ceil = ceilDb10;
  prev_rel = relMs;
  preTgt = pow(10.0, preGain10 / 200.0);
  ceilLin = pow(10.0, min(ceilDb10, -3) / 200.0);
  rel_k = 1.0 - exp(-1.0 / (max(relMs, 10) * 0.001 * fs));
);

// Smooth parameter interpolation
preLin += (preTgt - preLin) * pre_k;

// Input NaN / Inf guard
!(abs(spl0) < 1e6) ? ( spl0 = 0.0; );
!(abs(spl1) < 1e6) ? ( spl1 = 0.0; );

l = spl0 * preLin;
r = spl1 * preLin;

// 2.0 Hz Bessel DC Blocker with denormal prevention
yl = l - dxL + dcR * dyL; dxL = l; dyL = yl;
abs(dyL) < 1e-30 ? ( dyL = 0.0; );
l = dyL;

yr = r - dxR + dcR * dyR; dxR = r; dyR = yr;
abs(dyR) < 1e-30 ? ( dyR = 0.0; );
r = dyR;

// Continuous 4x Oversampled Sinc True-Peak Reconstruction (BS.1770-4)
ia0 = ia1; ib0 = ib1;
ia1 = ia2; ib1 = ib2;
ia2 = ia3; ib2 = ib3;
ia3 = ia4; ib3 = ib4;
ia4 = ia5; ib4 = ib5;
ia5 = ia6; ib5 = ib6;
ia6 = ia7; ib6 = ib7;
ia7 = l;   ib7 = r;

isp_pk = 0.0;
tpDetect > 0 ? (
  pL1 = abs(ia0 * -0.0058264 + ia1 * 0.0401948 + ia2 * -0.1398249 + ia3 * 0.8902301 + ia4 * 0.2743742 + ia5 * -0.0767304 + ia6 * 0.0181583 + ia7 * -0.0005757);
  pL2 = abs(ia0 * -0.0034509 + ia1 * 0.0391804 + ia2 * -0.1462624 + ia3 * 0.6105329 + ia4 * 0.6105329 + ia5 * -0.1462624 + ia6 * 0.0391804 + ia7 * -0.0034509);
  pL3 = abs(ia0 * -0.0005757 + ia1 * 0.0181583 + ia2 * -0.0767304 + ia3 * 0.2743742 + ia4 * 0.8902301 + ia5 * -0.1398249 + ia6 * 0.0401948 + ia7 * -0.0058264);

  pR1 = abs(ib0 * -0.0058264 + ib1 * 0.0401948 + ib2 * -0.1398249 + ib3 * 0.8902301 + ib4 * 0.2743742 + ib5 * -0.0767304 + ib6 * 0.0181583 + ib7 * -0.0005757);
  pR2 = abs(ib0 * -0.0034509 + ib1 * 0.0391804 + ib2 * -0.1462624 + ib3 * 0.6105329 + ib4 * 0.6105329 + ib5 * -0.1462624 + ib6 * 0.0391804 + ib7 * -0.0034509);
  pR3 = abs(ib0 * -0.0005757 + ib1 * 0.0181583 + ib2 * -0.0767304 + ib3 * 0.2743742 + ib4 * 0.8902301 + ib5 * -0.1398249 + ib6 * 0.0401948 + ib7 * -0.0058264);

  isp_pk = max(max(max(pL1, pL2), pL3), max(max(pR1, pR2), pR3));
);

pk = max(max(abs(l), abs(r)), isp_pk);
req = pk > ceilLin ? ceilLin / pk : 1.0;
req = min(max(req, 0.0), 1.0);

old = reqB[w];
(old < 1.0) ? ( active -= 1; );
(req < 1.0) ? ( active += 1; );
reqB[w] = req;
dlyL[w] = l;
dlyR[w] = r;

m = 1.0;
(active > 0) ? (
  i = 0;
  loop(N,
    (reqB[i] < m) ? ( m = reqB[i]; );
    i += 1;
  );
);

rec = eprev + (1.0 - eprev) * rel_k;
e = min(m, rec);
eprev = e;

esum += e - eB[ew];
eB[ew] = e;
ew += 1;
(ew >= D) ? ( ew = 0; );

chk += 1;
(chk >= N * 8) ? (
  i = 0; s = 0.0;
  loop(D, s += eB[i]; i += 1; );
  esum = s;
  chk = 0;
);

g = min(1.0, esum / D);
rp = w + 1;
(rp >= N) ? ( rp = 0; );

(fadeN < fadeLen) ? ( fadeN += 1; fg = fadeN / fadeLen; ) : ( fg = 1.0; );

spl0 = dlyL[rp] * g * fg;
spl1 = dlyR[rp] * g * fg;

spl0 = min(max(spl0, -ceilLin), ceilLin);
spl1 = min(max(spl1, -ceilLin), ceilLin);

w += 1;
(w >= N) ? ( w = 0; );
