desc:HyperAudio Speaker Dynamic Loudness v10 v5
//tags: speaker loudness compressor bass limiter true-peak

mode:2<0,2,1{Bypass,Limiter Only,Dynamic Loudness}>Processing Mode
inputGain10:0<-120,60,1>Input Gain tenths dB
compThresh:-20<-50,0,1>Dynamic Threshold dBFS
compRatio10:25<10,100,1>Compression Ratio x10
makeupDb:6<0,18,1>Loudness Makeup dB
vBassMix:30<0,100,1>Virtual Bass Harmonics percent
ceiling10:-15<-60,-3,1>Peak Ceiling tenths dBFS
releaseMs:80<20,300,1>Limiter Release ms
tpDetect:1<0,1,1{Off,On}>True Peak Detect

@init
tpDetect = 1;
fs = srate > 0 ? srate : 48000;
pre_k = 1.0 - exp(-1.0 / (0.01 * fs)); preLin = 1.0; preTgt = 1.0; ceilLin = 0.841395; rel_k = 0.001;
prev_pre = -99999; prev_ceil = -99999; prev_rel = -99999;
mode = 2;
inputGain10 = 0;
compThresh = -20;
compRatio10 = 25;
makeupDb = 6;
vBassMix = 30;
ceiling10 = -15;
releaseMs = 80;
prevMode = 2;
atkK = 1 - exp(-1 / (fs * 0.008)); relK = 1 - exp(-1 / (fs * 0.120)); holdK = exp(-1 / (fs * 0.020));
pkEnv = 0; compEnv = 0;
vb_w0 = 2 * $PI * 110 / fs; vb_alpha = sin(vb_w0) * 0.707;
vb_b0 = (1 - cos(vb_w0)) * 0.5; vb_b1 = 1 - cos(vb_w0); vb_b2 = vb_b0;
vb_a0 = 1 + vb_alpha; vb_a1 = -2 * cos(vb_w0); vb_a2 = 1 - vb_alpha;
vb_b0 /= vb_a0; vb_b1 /= vb_a0; vb_b2 /= vb_a0; vb_a1 /= -vb_a0; vb_a2 /= -vb_a0;
vb_xL1 = 0; vb_xL2 = 0; vb_yL1 = 0; vb_yL2 = 0; vb_xR1 = 0; vb_xR2 = 0; vb_yR1 = 0; vb_yR2 = 0;
hdc = exp(-2.0 * $PI * 20.0 / fs); hxL = 0; hyL = 0; hxR = 0; hyR = 0;

// shared limiter core v5: 1.5 ms lookahead, O(1) sliding minimum (monotonic deque), moving-average ramp, gated true-peak
L_D = max(2, min(500, floor(0.0015 * fs + 0.5)));
L_N = L_D + 1; L_cap = L_N + 1;
L_dlyL = 40000; L_dlyR = L_dlyL + L_N; L_dqV = L_dlyR + L_N; L_dqI = L_dqV + L_cap; L_eB = L_dqI + L_cap;
L_fadeLen = max(1, floor(0.05 * fs));
L_i = 0;
loop(L_N, L_dlyL[L_i] = 0; L_dlyR[L_i] = 0; L_i += 1; );
L_i = 0;
loop(L_cap, L_dqV[L_i] = 1.0; L_dqI[L_i] = 0; L_i += 1; );
L_i = 0;
loop(L_D, L_eB[L_i] = 1.0; L_i += 1; );
L_w = 0; L_head = 0; L_tail = 0; L_t = 0; L_ew = 0; L_eprev = 1.0; L_esum = L_D; L_chk = 0; L_fadeN = 0;
isp_hot = 0;
ia0 = 0; ib0 = 0;
ia1 = 0; ib1 = 0;
ia2 = 0; ib2 = 0;
ia3 = 0; ib3 = 0;
ia4 = 0; ib4 = 0;
ia5 = 0; ib5 = 0;
ia6 = 0; ib6 = 0;
ia7 = 0; ib7 = 0;

@sample
abs(spl0) < 1e6 ? 0 : (spl0 = 0.0);
abs(spl1) < 1e6 ? 0 : (spl1 = 0.0);
mode == 0 ? (
  prevMode = 0;
) : (
  prevMode == 0 ? (
    L_i = 0;
    loop(L_N, L_dlyL[L_i] = 0; L_dlyR[L_i] = 0; L_i += 1; );
    L_i = 0;
    loop(L_cap, L_dqV[L_i] = 1.0; L_dqI[L_i] = 0; L_i += 1; );
    L_i = 0;
    loop(L_D, L_eB[L_i] = 1.0; L_i += 1; );
    L_w = 0; L_head = 0; L_tail = 0; L_t = 0; L_ew = 0; L_eprev = 1.0; L_esum = L_D; L_chk = 0; L_fadeN = 0;
    isp_hot = 0;
    ia0 = 0; ib0 = 0;
    ia1 = 0; ib1 = 0;
    ia2 = 0; ib2 = 0;
    ia3 = 0; ib3 = 0;
    ia4 = 0; ib4 = 0;
    ia5 = 0; ib5 = 0;
    ia6 = 0; ib6 = 0;
    ia7 = 0; ib7 = 0;
    pkEnv = 0; compEnv = 0; hxL = 0; hyL = 0; hxR = 0; hyR = 0;
    vb_xL1 = 0; vb_xL2 = 0; vb_yL1 = 0; vb_yL2 = 0; vb_xR1 = 0; vb_xR2 = 0; vb_yR1 = 0; vb_yR2 = 0;
    prevMode = mode;
  );
  (inputGain10 != prev_pre || ceiling10 != prev_ceil || releaseMs != prev_rel) ? (
    prev_pre = inputGain10; prev_ceil = ceiling10; prev_rel = releaseMs;
    preTgt = pow(10.0, inputGain10 / 200.0);
    ceilLin = pow(10.0, min(ceiling10, -3) / 200.0);
    rel_k = 1.0 - exp(-1.0 / (max(releaseMs, 10) * 0.001 * fs));
  );
  preLin += (preTgt - preLin) * pre_k;
  l = spl0 * preLin; r = spl1 * preLin;
  mode == 2 ? (
    subL = vb_b0 * l + vb_b1 * vb_xL1 + vb_b2 * vb_xL2 + vb_a1 * vb_yL1 + vb_a2 * vb_yL2;
    vb_xL2 = vb_xL1; vb_xL1 = l; vb_yL2 = vb_yL1; vb_yL1 = subL;
    subR = vb_b0 * r + vb_b1 * vb_xR1 + vb_b2 * vb_xR2 + vb_a1 * vb_yR1 + vb_a2 * vb_yR2;
    vb_xR2 = vb_xR1; vb_xR1 = r; vb_yR2 = vb_yR1; vb_yR1 = subR;
    qL = subL * subL * 3.0; qR = subR * subR * 3.0;
    hyL = qL - hxL + hdc * hyL; hxL = qL; abs(hyL) < 1e-30 ? ( hyL = 0.0; );
    hyR = qR - hxR + hdc * hyR; hxR = qR; abs(hyR) < 1e-30 ? ( hyR = 0.0; );
    l += hyL * vBassMix * 0.01; r += hyR * vBassMix * 0.01;
    pkEnv = max(max(abs(l), abs(r)), pkEnv * holdK);
    pkEnv > compEnv ? ( compEnv += (pkEnv - compEnv) * atkK; ) : ( compEnv += (pkEnv - compEnv) * relK; );
    compGain = 1.0;
    compEnv > 0.00001 ? (
      overDb = 20 * log10(compEnv) - compThresh;
      overDb > 0 ? ( compGain = pow(10, -overDb * (1.0 - 10.0 / compRatio10) / 20); );
    );
    abs(pkEnv) < 1e-20 ? ( pkEnv = 0; ); abs(compEnv) < 1e-20 ? ( compEnv = 0; );
    abs(vb_yL1) < 1e-20 ? ( vb_yL1 = 0; ); abs(vb_yL2) < 1e-20 ? ( vb_yL2 = 0; ); abs(vb_yR1) < 1e-20 ? ( vb_yR1 = 0; ); abs(vb_yR2) < 1e-20 ? ( vb_yR2 = 0; );
    mk = pow(10, makeupDb / 20);
    l *= compGain * mk; r *= compGain * mk;
  );

  // ---- limiter core (input l,r; output spl0,spl1; needs ceilLin, rel_k) ----
  // true-peak (gated, unrolled): history shift
  ia0 = ia1; ib0 = ib1;
  ia1 = ia2; ib1 = ib2;
  ia2 = ia3; ib2 = ib3;
  ia3 = ia4; ib3 = ib4;
  ia4 = ia5; ib4 = ib5;
  ia5 = ia6; ib5 = ib6;
  ia6 = ia7; ib6 = ib7;
  ia7 = l; ib7 = r;
  isp_pk = 0;
  (tpDetect > 0 && max(abs(l), abs(r)) > ceilLin * 0.4) ? ( isp_hot = 8; ) : ( isp_hot -= 1; );
  isp_hot > 0 ? (
    isp_pk = max(isp_pk, abs((ia0 * -0.0058264 + ia1 * 0.0401948 + ia2 * -0.1398249 + ia3 * 0.8902301 + ia4 * 0.2743742 + ia5 * -0.0767304 + ia6 * 0.0181583 + ia7 * -0.0005757)));
    isp_pk = max(isp_pk, abs((ia0 * -0.0034509 + ia1 * 0.0391804 + ia2 * -0.1462624 + ia3 * 0.6105329 + ia4 * 0.6105329 + ia5 * -0.1462624 + ia6 * 0.0391804 + ia7 * -0.0034509)));
    isp_pk = max(isp_pk, abs((ia0 * -0.0005757 + ia1 * 0.0181583 + ia2 * -0.0767304 + ia3 * 0.2743742 + ia4 * 0.8902301 + ia5 * -0.1398249 + ia6 * 0.0401948 + ia7 * -0.0058264)));
    isp_pk = max(isp_pk, abs((ib0 * -0.0058264 + ib1 * 0.0401948 + ib2 * -0.1398249 + ib3 * 0.8902301 + ib4 * 0.2743742 + ib5 * -0.0767304 + ib6 * 0.0181583 + ib7 * -0.0005757)));
    isp_pk = max(isp_pk, abs((ib0 * -0.0034509 + ib1 * 0.0391804 + ib2 * -0.1462624 + ib3 * 0.6105329 + ib4 * 0.6105329 + ib5 * -0.1462624 + ib6 * 0.0391804 + ib7 * -0.0034509)));
    isp_pk = max(isp_pk, abs((ib0 * -0.0005757 + ib1 * 0.0181583 + ib2 * -0.0767304 + ib3 * 0.2743742 + ib4 * 0.8902301 + ib5 * -0.1398249 + ib6 * 0.0401948 + ib7 * -0.0058264)));
  );
  pk = max(max(abs(l), abs(r)), isp_pk);
  req = pk > ceilLin ? ceilLin / pk : 1.0;
  req = min(max(req, 0.0), 1.0);
  L_t += 1;
  while (L_tail > L_head && L_dqV[(L_tail - 1) % L_cap] >= req) ( L_tail -= 1; );
  L_dqV[L_tail % L_cap] = req; L_dqI[L_tail % L_cap] = L_t; L_tail += 1;
  while (L_dqI[L_head % L_cap] <= L_t - L_N) ( L_head += 1; );
  m = L_dqV[L_head % L_cap];
  L_dlyL[L_w] = l; L_dlyR[L_w] = r;
  rec = L_eprev + (1.0 - L_eprev) * rel_k;
  e = min(m, rec); L_eprev = e;
  L_esum += e - L_eB[L_ew]; L_eB[L_ew] = e; L_ew += 1; L_ew >= L_D ? ( L_ew = 0; );
  L_chk += 1;
  L_chk >= L_N * 8 ? ( L_i = 0; L_s = 0.0; loop(L_D, L_s += L_eB[L_i]; L_i += 1; ); L_esum = L_s; L_chk = 0; );
  g = min(1.0, L_esum / L_D);
  L_rp = L_w + 1; L_rp >= L_N ? ( L_rp = 0; );
  L_fadeN < L_fadeLen ? ( L_fadeN += 1; fg = L_fadeN / L_fadeLen; ) : ( fg = 1.0; );
  spl0 = min(max(L_dlyL[L_rp] * g * fg, -ceilLin), ceilLin);
  spl1 = min(max(L_dlyR[L_rp] * g * fg, -ceilLin), ceilLin);
  L_w += 1; L_w >= L_N ? ( L_w = 0; );
);
