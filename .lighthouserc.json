{
  "ci": {
    "collect": {
      "url": ["http://localhost:8765/index.html"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["is-on-https", "uses-http2", "redirects-http", "valid-source-maps"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": "off",
        "categories:best-practices": "off",
        "categories:seo": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-reports"
    }
  }
}
